nozzleAdc: PrinterNozzle.AT32ADC @ sysbus 0x40012400
nozzlePort: PrinterNozzle.AT32GPIO @ sysbus 0x40010c00
bedAdc: PrinterMain.AT32ADC @ sysbus 0x41012400
bedPort: PrinterMain.AT32GPIO @ sysbus 0x41010800
// EXPLICIT HYPOTHETICAL SCENARIO, not measured printer characteristics.
// Fresh paused setup only, INSTEAD OF the ordinary nozzle thermal fixture.
// Requires unchanged nozzle VirtualPrinterThermal and NativeNozzleHeaterBinding.
// Shared namespace generation must replace AT32 with PrinterNozzle.
virtualNozzleNTC: PrinterNozzle.VirtualPrinterThermal @ sysbus
    adc: nozzleAdc
    channel: 0
    heaterPowerWatts: 60
    heatCapacityJoulesPerKelvin: 20
    conductanceWattsPerKelvin: 0.2
    ambientCelsius: 25
    pullResistanceOhms: 4700
    adcMaximum: 4095
    thermistorToGround: true
    useRecoveredNozzleCurve: true
    maximumCelsius: 400
    stopHeaterAtMaximum: true
    updateMicroseconds: 10000
    heaterActiveHigh: true

nativeNozzleHeaterBinding: PrinterNozzle.NativeNozzleHeaterBinding @ sysbus
    portB: nozzlePort
    thermal: virtualNozzleNTC
// PB9 intentionally unbound. Existing passive observer may still record it.

// EXPLICIT HYPOTHETICAL SCENARIO, not measured printer characteristics.
// Same thermal/sensor constants and guards as the ordinary bed fixture.
// Fresh paused setup only, INSTEAD OF virtual-bed-ntc/virtual-commanded-bed.
// Shared namespace generation must replace AT32 with PrinterMain.
virtualBedNTC: PrinterMain.VirtualPrinterThermal @ sysbus
    adc: bedAdc
    channel: 8
    heaterPowerWatts: 200
    heatCapacityJoulesPerKelvin: 600
    conductanceWattsPerKelvin: 1.5
    ambientCelsius: 25
    nominalResistanceOhms: 100000
    betaKelvin: 3950
    nominalCelsius: 25
    pullResistanceOhms: 4700
    adcMaximum: 4095
    thermistorToGround: true
    maximumCelsius: 150
    stopHeaterAtMaximum: true
    updateMicroseconds: 10000
    heaterActiveHigh: true

syntheticBedHeaterBinding: ThermalExperimental.ResolvedBedHeaterBinding @ sysbus
    portA: bedPort
    thermal: virtualBedNTC

checks: ThermalExperimental.SyntheticThermalTests @ sysbus
    nozzlePort: nozzlePort
    bedPort: bedPort
    nozzleAdc: nozzleAdc
    bedAdc: bedAdc
    nozzle: virtualNozzleNTC
    bed: virtualBedNTC
    nozzleBinding: nativeNozzleHeaterBinding
    bedBinding: syntheticBedHeaterBinding
