include @scripts/load.resc
include @scripts/board-clock-and-rtc.resc
include @scripts/generic-stationary-rl.resc
include @peripherals/AT32F403A_VirtualSerialWire.cs
include @tests/CurrentLoopTrace.cs
machine LoadPlatformDescriptionFromString "wire: AT32.AT32VirtualSerialWire @ sysbus { uart: usart2; baud: 576000 }"
machine LoadPlatformDescriptionFromString "trace: AT32Tests.CurrentLoopTrace @ sysbus { plant: rlPlant; tmr1: tmr1; tmr3: tmr3; tmr4: tmr4; tmr8: tmr8 }"
sysbus LoadBinary @/workspace/shared/kobra4-firmware/payload/motor_firmware_v1.6.01_20260313.bin 0x08008000
cpu VectorTableOffset 0x08008000
sysbus.usart2 CreateFileBackend @/workspace/scratch/ca95ca5f55d9/motor-renode/tests/results/current-loop-full/responses.bin
emulation RunFor "1"
