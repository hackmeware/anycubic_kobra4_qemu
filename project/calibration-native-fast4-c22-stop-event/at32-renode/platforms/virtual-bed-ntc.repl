// Proven original-host ADC input: OID18 ADC1 channel8/PB0, Hotbed NTC UI10123.
// Illustrative 100k/B3950/4.7k curve, not recovered board calibration.
// No heater PWM connected until actual output mapping is proven.
virtualBedNTC: AT32.VirtualPrinterThermal @ sysbus
    adc: adc1
    channel: 8
    ambientCelsius: 25
    nominalResistanceOhms: 100000
    nominalCelsius: 25
    betaKelvin: 3950
    pullResistanceOhms: 4700
    heaterPowerWatts: 200
    heatCapacityJoulesPerKelvin: 600
    conductanceWattsPerKelvin: 1.5
    maximumCelsius: 150
