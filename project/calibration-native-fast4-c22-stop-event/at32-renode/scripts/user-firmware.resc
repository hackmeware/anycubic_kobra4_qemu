# Place the user's application at firmware/mcu_firmware_v1.3.3_20260311.bin,
# or set $bin before including this script. No user binary is distributed.
$bin?=@firmware/mcu_firmware_v1.3.3_20260311.bin
include @scripts/load.resc
sysbus LoadBinary $bin 0x08004000
sysbus.cpu VectorTableOffset 0x08004000
sysbus.cpu SP 0x20008000
sysbus.cpu PC 0x08008099
showAnalyzer sysbus.usart1
# Explicitly use start after attaching board peripherals or a host bridge.
