nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    IRQ -> cpu@0
cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4"
    nvic: nvic
crm: AT32.AT32CRM @ sysbus 0x40021000
    nvic: nvic
timer: Nozzle.ClockedSTM32Timer @ sysbus 0x40000000
checks: AT32Tests.NozzleTimerFrequencyTests @ sysbus
    timer: timer
    crm: crm
