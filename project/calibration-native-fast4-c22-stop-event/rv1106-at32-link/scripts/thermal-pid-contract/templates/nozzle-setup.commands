include @scripts/virtual-nozzle-recovered-ntc.resc
include @scripts/virtual-tmc2209.resc
include @scripts/passive-tmc-timing-observer.resc
emulation SetGlobalQuantum "0.000001"
sysbus.spi1 StartPassiveByteTrace "${RUN_DIR}/nozzle-spi1-bytes.csv" 65536
sysbus.spi2 StartPassiveByteTrace "${RUN_DIR}/nozzle-spi2-bytes.csv" 65536
machine LoadPlatformDescriptionFromString "identificationGpioA: PrinterShared.PassiveGpioEdgeTrace @ sysbus { maximumRows: 100000 }"
