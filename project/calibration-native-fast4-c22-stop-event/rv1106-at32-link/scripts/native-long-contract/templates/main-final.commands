pause
machine ElapsedVirtualTime
mach set "motor"
sysbus.physicalStateTrace Stop
sysbus.physicalStateTrace WriteStatus "${RUN_DIR}/physical-state-status.json"
mach set "main"
mach set "motor"
sysbus.electromechanicalPlant StopContactTrace
sysbus.electromechanicalPlant ContactRowsWritten
sysbus.electromechanicalPlant ContactDroppedRows
sysbus.electromechanicalPlant ContactLastError
sysbus.electromechanicalPlant IntegrationCalls
mach set "main"
mach set "main"
sysbus.homingEdges DroppedRows
sysbus.homingEdges LastError
mach set "motor"
sysbus.homingEdges DroppedRows
sysbus.homingEdges LastError
mach set "main"
mach set "nozzle"
echo "COLD_PROBE_nozzle_BEGIN"
sysbus.zProbeEdges Enabled
sysbus.zProbeEdges Stop
sysbus.zProbeEdges Enabled
