mach set "motor"
echo "COLD_CONTACT_BEGIN"
sysbus.electromechanicalPlant ContactTraceEnabled
sysbus.electromechanicalPlant ContactRowsWritten
sysbus.electromechanicalPlant ContactDroppedRows
sysbus.electromechanicalPlant ContactLastError
echo "COLD_CONTACT_END"
mach set "main"
mach set "main"
echo "IDENT_SPI_main_spi1_BEGIN"
sysbus.spi1 StopPassiveByteTrace
sysbus.spi1 PassiveTraceEnabled
sysbus.spi1 PassiveRowsWritten
sysbus.spi1 PassiveDroppedRows
