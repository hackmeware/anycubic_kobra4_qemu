# Explicit scenario only. Original software limits: X -18.5..280, Y -7.5..272.5 mm.
# Assume initial physical carriages at each software-range midpoint, not known real positions.
# Relative half spans: X 149.25 mm, Y 140 mm. No coordinate or homed flag is written.
# Stops generate torque in physical rotor kernel, never synthetic DIAG/endstop levels.
sysbus.electromechanicalPlant ConfigureRelativeContact 0 -149.25 149.25 10 0.01
sysbus.electromechanicalPlant ConfigureRelativeContact 1 -140 140 10 0.01
include @peripherals/PassivePhysicalStateTrace.cs
machine LoadPlatformDescription @platforms/passive-physical-state-trace.repl
sysbus.physicalStateTrace ConfigureLongRun 80000
sysbus.physicalStateTrace Start "${RUN_DIR}/physical-state.csv"
sysbus.electromechanicalPlant StartContactTrace "${RUN_DIR}/contact-transitions.csv" 100000 true
sysbus.spi1 StartPassiveByteTrace "${RUN_DIR}/motor-spi1-bytes.csv" 65536
sysbus.spi2 StartPassiveByteTrace "${RUN_DIR}/motor-spi2-bytes.csv" 65536
sysbus.spi3 StartPassiveByteTrace "${RUN_DIR}/motor-spi3-bytes.csv" 65536
sysbus.spi4 StartPassiveByteTrace "${RUN_DIR}/motor-spi4-bytes.csv" 65536
machine LoadPlatformDescriptionFromString "identificationGpioA: PrinterShared.PassiveGpioEdgeTrace @ sysbus { maximumRows: 100000 }"
sysbus.identificationGpioA Observe sysbus.gpioA 0 "motor_PA0"
sysbus.identificationGpioA Observe sysbus.gpioA 1 "motor_PA1"
sysbus.identificationGpioA Observe sysbus.gpioA 2 "motor_PA2"
sysbus.identificationGpioA Observe sysbus.gpioA 3 "motor_PA3"
sysbus.identificationGpioA Observe sysbus.gpioA 4 "motor_PA4"
sysbus.identificationGpioA Observe sysbus.gpioA 5 "motor_PA5"
sysbus.identificationGpioA Observe sysbus.gpioA 6 "motor_PA6"
sysbus.identificationGpioA Observe sysbus.gpioA 7 "motor_PA7"
sysbus.identificationGpioA Observe sysbus.gpioA 8 "motor_PA8"
sysbus.identificationGpioA Observe sysbus.gpioA 9 "motor_PA9"
sysbus.identificationGpioA Observe sysbus.gpioA 10 "motor_PA10"
sysbus.identificationGpioA Observe sysbus.gpioA 11 "motor_PA11"
sysbus.identificationGpioA Observe sysbus.gpioA 12 "motor_PA12"
sysbus.identificationGpioA Observe sysbus.gpioA 13 "motor_PA13"
sysbus.identificationGpioA Observe sysbus.gpioA 14 "motor_PA14"
sysbus.identificationGpioA Observe sysbus.gpioA 15 "motor_PA15"
sysbus.identificationGpioA ConfigureLongRun 3000000 268435456
sysbus.identificationGpioA Start "${RUN_DIR}/motor-gpioA-edges.csv"
